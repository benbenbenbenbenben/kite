{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LSP",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "kite-cli"],
      "options": {
        "cwd": "${workspaceFolder}/.."
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Compile Extension",
      "type": "npm",
      "script": "compile",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build Extension + LSP",
      "dependsOn": ["Build LSP", "Compile Extension"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
